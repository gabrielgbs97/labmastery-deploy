# LabMastery — plantilla del .env del compose.
#
# El .env REAL lo genera el playbook de ansible-vault y NO se commitea.
# Esta plantilla sirve de referencia de las variables y para desarrollo.
#
#   cp .env.example .env   (solo en desarrollo)

# --- Nombre del stack (prefijos de redes y volumenes) ---
STACK_NAME=labmastery

# --- Imagenes (tags inmutables, nunca latest) ---
IMAGE_WEB=ghcr.io/gabrielgbs97/labmastery-web:0.2.0
IMAGE_CONSOLE=ghcr.io/gabrielgbs97/labmastery-console:0.1.0
IMAGE_ORCHESTRATOR=ghcr.io/gabrielgbs97/labmastery-orchestrator:0.1.0
IMAGE_GATEWAY=ghcr.io/gabrielgbs97/labmastery-gateway:0.1.0

# --- PostgreSQL ---
POSTGRES_DB=labmastery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
LM_DB_ROLES=lm_web,lm_console,lm_orchestrator,lm_reporting
LM_DB_PASSWORDS=lm_web_dev,lm_console_dev,lm_orchestrator_dev,lm_reporting_dev

# --- S3 (RustFS) ---
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY_ID=lmdevaccess
S3_SECRET_ACCESS_KEY=lmdevsecret123

# --- Credenciales de servicio (capa 1) ---
WEB_SECRET_KEY=changeme-web-secret-key-32-bytes-lon
OWNER_REF_SECRET=changeme-owner-ref-secret
SESSION_SECRET=changeme-session-secret
ORCH_SECRET_KEY=changeme-orch-secret-key-32-bytes-lon
ORCH_CLIENTS=[{"clientId":"console","token":"changeme-console-token"},{"clientId":"web","token":"changeme-web-token"}]

# --- Magatzems de secrets ---
# JSON: lista de diccionarios [UUID -> credencial]. El mismo valor en los tres
# servicios. Ahi va el token de cada instancia de Vault/OpenBao.
SETTINGS_SECRET_STORES=[]

# --- Host de labs (Docker-in-Docker, D24) ---
# Perfil `labs`: docker compose --profile labs up -d
# El orquestador gestiona los contenedores de lab contra este daemon. La consola
# manda (provider.docker.host en la BD); esto es solo el respaldo por entorno.
ORCH_PROVIDER=docker
DOCKER_HOST=tcp://dind:2375

# --- Gateway de sesiones (H1) ---
# GATEWAY_TOKEN_SECRET debe ser el MISMO valor que en el orquestador: es lo que
# abre los tokens de conexión de las terminales.
GATEWAY_TOKEN_SECRET=changeme-gateway-token-secret-32-b
GATEWAY_SSH_USER=student
# Contraseña que el orquestador inyecta en el contenedor (injectIdentity → chpasswd)
GATEWAY_SSH_PASSWORD=changeme-student-password
GATEWAY_IDLE_TIMEOUT_SECONDS=900

# --- URLs ---
ORCH_URL=http://orchestrator:4000
OAUTH_PUBLIC_URL=https://console.labmastery.local
AUTH_MODE=oauth
CONSOLE_OAUTH_USERS=[]

# --- Puertos publicados (solo HAProxy) ---
HTTPS_PORT=443
HTTP_PORT=80
