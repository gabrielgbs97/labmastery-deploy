# syntax=docker/dockerfile:1.7
# LabMastery — imagen del web (BFF Fastify + SPA Vue).
#
# CONTEXTO DE BUILD: la raiz de los repos (c:\dev\LabMastery).
#
#   docker build -f labmastery-deploy/docker/Dockerfile.web -t labmastery-web .
#
# EL TRUCO DE LOS PAQUETS `file:` (D23 §4.1): los paquetes `@labmastery/*`
# exportan codigo FUENTE (.ts). Node 24 hace type stripping, pero NO dentro
# de node_modules (ERR_UNSUPPORTED_NODE_MODULES_TYPE_STRIPPING). La solucion:
# que el codigo real de los paquetes viva FUERA de node_modules.
#
#   /opt/pkgs/packages/config/src/*.ts   <- el fuente, fuera de node_modules
#
# npm NO instala las dependencias de los paquetes `file:` (solo crea el
# symlink), asi que las deps externas de los paquetes (zod, shiki, marked...)
# se instalan explicitamente en labmastery-packages.
#
# Requisito: los repos al mismo nivel (D23).

# ---------- Etapa 1: dependencias --------------------------------------------
FROM node:24-alpine AS deps
WORKDIR /app

COPY labmastery-packages /app/labmastery-packages
COPY labmastery-web/package.json ./labmastery-web/
COPY labmastery-web/server/package.json ./labmastery-web/server/
COPY labmastery-web/web/package.json ./labmastery-web/web/

RUN cd /app/labmastery-web \
 && npm install --no-audit --no-fund \
 && cd /app/labmastery-packages \
 && npm install --no-audit --no-fund --omit=dev --no-save \
      $(node -e "const p=require('./packages/lab-renderer/package.json'),q=require('./packages/orchestrator-client/package.json'),r=require('./packages/config/package.json'),s=require('./packages/lab-schema/package.json');const d={...p.dependencies,...q.dependencies,...r.dependencies,...s.dependencies};console.log(Object.entries(d).map(([k,v])=>k+'@'+v.replace(/^\^/,'')).join(' '))")

# ---------- Etapa 2: front (SPA) ---------------------------------------------
FROM node:24-alpine AS front
WORKDIR /app

COPY --from=deps /app/labmastery-packages ./labmastery-packages
COPY --from=deps /app/labmastery-web/node_modules ./labmastery-web/node_modules
COPY labmastery-web/web ./labmastery-web/web
COPY labmastery-web/scripts ./labmastery-web/scripts
COPY labmastery-web/tsconfig.base.json ./labmastery-web/

# Los symlinks de @labmastery/* apuntan a rutas de Windows: hay que rehacerlos
# para que apunten al codigo fuente que esta aqui.
RUN set -eux; \
    mkdir -p ./labmastery-web/node_modules/@labmastery; \
    for n in config i18n lab-renderer lab-schema orchestrator-client secret-store settings-registry; do \
      [ -d "./labmastery-packages/packages/$n" ] || continue; \
      ln -sfn "/app/labmastery-packages/packages/$n" "./labmastery-web/node_modules/@labmastery/$n"; \
    done

WORKDIR /app/labmastery-web/web
RUN npm run build

# ---------- Etapa 3: aplicacion ----------------------------------------------
FROM node:24-alpine AS app
WORKDIR /app

ENV NODE_ENV=production

# Un unico node_modules, el de la app (npm hoistea los workspaces).
COPY --from=deps /app/labmastery-web/node_modules /app/node_modules

# El codigo de los paquetes, FUERA de node_modules (para el type stripping).
# Su node_modules se conserva: ahi estan las deps externas de los paquetes.
COPY --from=deps /app/labmastery-packages /opt/pkgs

# Los symlinks que npm creo en /opt/pkgs/node_modules apuntan a rutas del host
# de build (C:\...): hay que rehacerlos.
RUN set -eux; \
    mkdir -p /opt/pkgs/node_modules/@labmastery; \
    for n in config i18n lab-renderer lab-schema orchestrator-client secret-store settings-registry; do \
      [ -d "/opt/pkgs/packages/$n" ] || continue; \
      ln -sfn "/opt/pkgs/packages/$n" "/opt/pkgs/node_modules/@labmastery/$n"; \
    done

COPY labmastery-web/package.json ./labmastery-web/
COPY labmastery-web/server ./labmastery-web/server
COPY labmastery-web/labs ./labmastery-web/labs
COPY --from=front /app/labmastery-web/web/dist ./labmastery-web/web/dist

# Symlinks de los paquetes `file:` tambien en el node_modules de la app.
RUN set -eux; \
    mkdir -p /app/node_modules/@labmastery; \
    for n in config i18n lab-renderer lab-schema orchestrator-client secret-store settings-registry; do \
      [ -d "/opt/pkgs/packages/$n" ] || continue; \
      ln -sfn "/opt/pkgs/packages/$n" "/app/node_modules/@labmastery/$n"; \
    done

WORKDIR /app/labmastery-web

# El proceso no escribe nada: usuario sin privilegios.
USER node

EXPOSE 3000

ENV WEB_DIST=/app/labmastery-web/web/dist \
    PORT=3000 \
    HOST=0.0.0.0

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "server/src/index.ts"]
