# LabMastery — .env del compose.
#
# Generado por el playbook de ansible-vault. NO se commitea.
# Permisos 0600: contiene credenciales.
#
# Este fichero es la CAPA 1 de D22 (variables de arranque). Los valores de los
# ajustes secrets NO estan aqui: viven en Vault y la BD guarda la referencia.

# --- Nombre del stack (prefijos de redes y volumenes) -----------------------
STACK_NAME={{ labmastery_stack_name }}

# --- Imagenes (tags inmutables, nunca latest) ------------------------------
IMAGE_WEB={{ labmastery_image_web | default('ghcr.io/gabrielgbs97/labmastery-web:latest') }}
IMAGE_CONSOLE={{ labmastery_image_console | default('ghcr.io/gabrielgbs97/labmastery-console:latest') }}
IMAGE_ORCHESTRATOR={{ labmastery_image_orchestrator | default('ghcr.io/gabrielgbs97/labmastery-orchestrator:latest') }}

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB={{ labmastery_postgres_db | default('labmastery') }}
POSTGRES_USER=postgres
POSTGRES_PASSWORD={{ labmastery_postgres_password }}
LM_DB_ROLES={{ labmastery_db_roles | default('lm_web,lm_console,lm_orchestrator,lm_reporting') }}
LM_DB_PASSWORDS={{ labmastery_db_passwords.values() | join(',') }}

# --- S3 (RustFS) -------------------------------------------------------------
S3_ENDPOINT=http://s3:9000
S3_ACCESS_KEY_ID={{ labmastery_s3_access_key }}
S3_SECRET_ACCESS_KEY={{ labmastery_s3_secret_key }}

# --- Credenciales de servicio (capa 1) --------------------------------------
WEB_SECRET_KEY={{ labmastery_web_secret_key }}
OWNER_REF_SECRET={{ labmastery_owner_ref_secret }}
SESSION_SECRET={{ labmastery_session_secret }}
ORCH_SECRET_KEY={{ labmastery_orch_secret_key }}
ORCH_CLIENTS={{ labmastery_orch_clients }}

# --- Magatzems de secrets ----------------------------------------------------
# JSON: lista de diccionarios [UUID -> credencial]. El MISMO valor en los tres
# servicios. Lo sirve el gestor de secrets del despliegue.
SETTINGS_SECRET_STORES={{ labmastery_secret_stores }}

# --- URLs --------------------------------------------------------------------
ORCH_URL=http://orchestrator:4000
OAUTH_PUBLIC_URL={{ labmastery_oauth_public_url }}
AUTH_MODE=oauth
CONSOLE_OAUTH_USERS={{ labmastery_console_oauth_users | default('[]') }}

# --- Puertos publicados (solo HAProxy) --------------------------------------
HTTPS_PORT=443
HTTP_PORT=80
